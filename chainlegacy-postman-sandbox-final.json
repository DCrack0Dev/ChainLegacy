{
  "info": {
    "name": "ChainLegacy API v1 - Sandbox (Final)",
    "_postman_id": "chainlegacy-sandbox-final",
    "description": "Final importable Postman collection for ChainLegacy API v1 — execution-focused sandbox quickstart.\n\nDO NOT include real secrets in exported collections.\nFollow the 5-minute run in folder order.\n\nFolders: 01 - Authentication, 02 - Organization, 03 - Customer, 04 - Legacy Plan, 05 - Guardian, 06 - Liveness, 07 - Claims, 08 - Webhooks, 09 - Audit, 10 - Operator Only",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Firebase Sign-In (email/password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{firebaseTestUserEmail}}\",\n  \"password\": \"{{firebaseTestUserPassword}}\",\n  \"returnSecureToken\": true\n}"
            },
            "url": {
              "raw": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{firebaseWebApiKey}}",
              "host": [
                "https://identitytoolkit.googleapis.com"
              ],
              "path": [
                "v1",
                "accounts:signInWithPassword"
              ],
              "query": [
                {
                  "key": "key",
                  "value": "{{firebaseWebApiKey}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Firebase sign-in returns 200', function() { pm.response.to.have.status(200); });",
                  "var resp = pm.response.json();",
                  "if (resp.idToken) {",
                  "  pm.environment.set('idToken', resp.idToken);",
                  "  console.log('idToken saved to environment (do not export)');",
                  "} else {",
                  "  console.log('No idToken in response');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Organization",
      "item": [
        {
          "name": "Create Organization (requires Firebase idToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Sandbox Org\",\n  \"slug\": \"demo-sandbox-org\",\n  \"country\": \"US\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/organizations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "organizations"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Organization create returns 201', function() { pm.response.to.have.status(201); });",
                  "var b = pm.response.json();",
                  "if (b.organizationId) pm.environment.set('organizationId', b.organizationId);",
                  "// Capture show-once API key if present — store locally and DO NOT export this environment",
                  "if (b.defaultSandboxKey && b.defaultSandboxKey.secret) {",
                  "  pm.environment.set('apiKey', b.defaultSandboxKey.secret);",
                  "  console.log('Captured show-once apiKey (store locally).');",
                  "} else {",
                  "  console.log('No show-once apiKey returned. Operator may need to pre-create a demo key.');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
